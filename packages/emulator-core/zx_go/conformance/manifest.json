    {
      "id": "nexttests",
      "title": "MrKWatkins/ZXSpectrumNextTests — test inventory",
      "page": "nexttests.html",
      "link": "https://github.com/MrKWatkins/ZXSpectrumNextTests",
      "description": "The main community acceptance suite for Spectrum Next emulators and FPGA cores: .nex/.tap programs with reference screenshots from real hardware. Statuses flip from planned to live results as each test is wired into the headless harness (ZX Play work item #137).",
      "groups": [
        {
          "name": "base — CPU and register fundamentals",
          "tests": [
            { "name": "Z80N", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/base/Z80N", "notes": "Extended Z80N instruction behaviour" },
            { "name": "Z80Nc2", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/base/Z80Nc2", "notes": "Z80N, core 2 variant" },
            { "name": "NextReg_defaults", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/base/NextReg_defaults", "notes": "Reset/default NextReg values — overlaps our dispatcher default tests" },
            { "name": "Copper", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/base/Copper", "notes": "Copper coprocessor behaviour" },
            { "name": "DMA", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/base/DMA", "notes": "zxnDMA behaviour" }
          ]
        },
        {
          "name": "Graphics — Layer 2 and layer mixing",
          "tests": [
            { "name": "Layer2Colours", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/Graphics/Layer2Colours" },
