  "suites": [
    {
      "id": "z80test",
      "title": "raxoft/z80test v1.2a — test inventory",
      "page": "z80test.html",
      "link": "https://github.com/raxoft/z80test",
      "description": "Patrik Rak's Z80 instruction exerciser: exhaustive per-instruction CRCs compared against captures from a real Zilog Z80 in a 48K Spectrum. Vendored release taps (pkg/testharness/testdata/z80test) run on the 48K harness via direct CODE-block injection. All six CPU variants pass; z80ccfscr is manual/visual only.",
      "groups": [
        {
          "name": "Variants",
          "tests": [
            {
              "name": "z80doc",
              "path": "https://github.com/raxoft/z80test",
              "runner": {
                "package": "github.com/conorarmstrong/zx_go/pkg/testharness",
                "tests": [
                  "TestZ80TestDoc"
                ]
              },
              "notes": "All registers, documented flags — 160/160 pass"
            },
            {
              "name": "z80docflags",
              "path": "https://github.com/raxoft/z80test",
              "runner": {
                "package": "github.com/conorarmstrong/zx_go/pkg/testharness",
                "tests": [
                  "TestZ80TestDocFlags"
                ]
              },
              "notes": "Documented flags only — 160/160 pass"
            },
            {
              "name": "z80flags",
              "path": "https://github.com/raxoft/z80test",
              "runner": {
                "package": "github.com/conorarmstrong/zx_go/pkg/testharness",
                "tests": [
                  "TestZ80TestFlags"
                ]
              },
              "notes": "All flags — 160/160 pass (Q register + block/OUTx flag work, ZX Play #141)"
            },
            {
              "name": "z80full",
              "path": "https://github.com/raxoft/z80test",
              "runner": {
                "package": "github.com/conorarmstrong/zx_go/pkg/testharness",
                "tests": [
                  "TestZ80TestFull"
                ]
              },
              "notes": "All flags and registers — 160/160 pass"
            },
            {
              "name": "z80ccf",
              "path": "https://github.com/raxoft/z80test",
              "runner": {
                "package": "github.com/conorarmstrong/zx_go/pkg/testharness",
                "tests": [
                  "TestZ80TestCcf"
                ]
              },
              "notes": "Flags after CCF following every instruction — 160/160 pass (the Q register)"
            },
            {
              "name": "z80memptr",
              "path": "https://github.com/raxoft/z80test",
              "runner": {
                "package": "github.com/conorarmstrong/zx_go/pkg/testharness",
                "tests": [
                  "TestZ80TestMemptr"
                ]
              },
              "notes": "BIT n,(HL) after every instruction — 160/160 pass (MEMPTR emulation is deeper than its in-source caveat suggests)"
            },
            {
              "name": "z80ccfscr",
              "path": "https://github.com/raxoft/z80test",
              "notes": "Visualises random CCF behaviour; emulators produce a stable pattern by construction — manual/visual only, not wired into CI",
              "status": "manual"
            }
          ]
        }
      ]
    },
