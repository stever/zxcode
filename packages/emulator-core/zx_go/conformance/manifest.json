            { "name": "Z80IntSkip (basics)", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/ZX48_ZX128/Z80IntSkip", "runner": { "package": "github.com/conorarmstrong/zx_go/pkg/testharness", "tests": ["TestNexttestsZ80IntSkipBasics"] }, "notes": "NOP benchmark, DI inhibition, SCF/CCF chains, IFF2 reads during int-ack" },
            { "name": "Z80IntSkip (prefix/EI inhibition)", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/ZX48_ZX128/Z80IntSkip", "runner": { "package": "github.com/conorarmstrong/zx_go/pkg/testharness", "tests": ["TestNexttestsZ80IntSkipInhibition"] }, "notes": "SKIP = documented gap: INT acceptance not inhibited after DD/FD prefixes or EI; /INT pulse re-entry once not 2+ — known-gaps.md, ZX Play #141" },
