        {
          "name": "ZX48 / ZX128 classic tests",
          "tests": [
            { "name": "Z80BlockInstructionFlags", "path": "https://github.com/MrKWatkins/ZXSpectrumNextTests/tree/develop/Tests/ZX48_ZX128/Z80BlockInstructionFlags", "runner": { "package": "github.com/conorarmstrong/zx_go/pkg/testharness", "tests": ["TestNexttestsZ80BlockFlags"] }, "notes": "SKIP = documented gap: interrupted-block-instruction flags (David Banks) not implemented — known-gaps.md, ZX Play #141" },
