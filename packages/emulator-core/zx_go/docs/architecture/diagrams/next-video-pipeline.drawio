<mxfile host="app.diagrams.net" version="24.7.7">
  <diagram id="next-video" name="Next video pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v0" value="ULA.Render() base pass&#10;classic pre-render + per-line border into the 640×256 output frame (two output px per frame px&#10;— the FPGA 14 MHz pixel bus shape; classics keep 320×240). The FPGA whc/wvc coordinate&#10;system: paper at frame (32,32). Timex modes UNIFIED in the row walk (#183): mode re-latched&#10;per character cell, hi-res = the native interleaved-files 512 stream, stable AND mixed frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="Per active scanline y (0..191): copper RunToCycle interleaved per 14 MHz HALF-PIXEL&#10;(2-cycle targets, one MOVE write per half-pixel) with the live-palette ULA row render&#10;(renderNextULARow: zxula.vhd decode, ULANext NR$42/$43, NR$26/$27 scroll + NR$68 bit 2&#10;fine-scroll-X as the 14 MHz barrel-shift LSB, NR$1A clip, raster-stamped NR$43 replay,&#10;(line,hpos) CPU palette stamps applied at their half-pixel). Row stride gated by&#10;copper.CanRetireOnLine: event rows pace per half-pixel, event-free rows coalesce pairs.&#10;MOVE=2 / NOOP=1 cycles at 28MHz; WAIT at vcount==Y &amp;&amp; hcount&gt;=(X&lt;&lt;3)+12;&#10;lines 192..311 swept after the visible rows — per half-pixel on lines with retirable copper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l-ula" value="ULA row&#10;(already rendered&#10;RGBA row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l-l2" value="Layer 2&#10;RenderScanline&#10;256×192 / 320×256 /&#10;640×256, scroll, clip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="230" y="250" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l-tm" value="Tilemap (Layer 3)&#10;40/80 col, textmode,&#10;mirror/rotate, scroll, clip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="410" y="250" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l-spr" value="Sprites (128)&#10;4/8bpp, scale, mirror,&#10;rotate, anchor groups,&#10;NR$4B transparency (raw pattern),&#10;dual NR$34/IO indexes (NR$09 tie),&#10;per-line budget + collision $303B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l-lores" value="LoRes / Radastan&#10;128×96 (lores.vhd transcription)&#10;NR$15 bit 7: replaces the ULA pixel in-clip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="790" y="250" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l-pal" value="Palettes (pkg/next/palette)&#10;9-bit RGB333, 256 entries × 8 banks (first/second per layer)&#10;per-entry Layer 2 priority bit (NR$44 bit 7)&#10;+ raster-stamped content-write log: mid-frame CPU NR$41/$44 writes&#10;rewound + replayed per row by the compositor pass (BeginReplay/&#10;ReplayThrough/RewindReplay/EndReplay; copper render-time writes unlogged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l-clip" value="Clip windows NR$18-$1B&#10;(4-coordinate + 2-bit index protocol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="530" y="350" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Compositor: ONE per-pixel chain (composePixel) behind two entries&#10;ComposeScanline(y) — coalesced rows · BeginLiveRow/ComposeLiveHalfPixel — FUSED paced rows,&#10;palettes + selects + NR$14/$68 + NR$15 mode read LIVE per half-pixel inside the copper interleave&#10;(layer INDEX buffers per row: the hardware grain — sprites line-buffer build-ahead sprites.vhd:537-540)&#10;priority order NR$15 bits 4:2 (SLU/LSU/SUL/LUS/USL/ULS + additive blends); SUL per-pixel stencil&#10;Layer 2 priority-bit promotion · ULA+tilemap combine · NR$4A fallback&#10;(mixer.go = fully faithful zxnext.vhd:7100-7355 port)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="450" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Wide overlay paths (composited in place on the 640-wide frame)&#10;hi-res Layer 2: renderHiResLayer2 (320-wide paints pairs, 640 native;&#10;sprites repainted on top in the S-above-L NR$15 modes)&#10;80-col tilemap: renderWide (native 640 tilemap over the doubled lower layers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="850" y="460" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Border passes over the full frame (xScale output px per frame px)&#10;ComposeBorderRow (tilemap in border) · ComposeSpriteBorderRow (sprites over border)&#10;image row = frame row for every layer (one origin, no bias)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="600" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="Final RGBA frame — live Next always 640×256&#10;every mode composites into a fixed canvas (browser: 640×512), so page layout never moves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ev0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="v0" target="v1"><mxGeometry relative="1" as="geometry" /></mxCell>
