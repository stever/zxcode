<mxfile host="app.diagrams.net" version="24.7.7">
  <diagram id="next-boot" name="Next boot chain">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-faithful" value="Faithful cold boot (default; desktop always uses this)" style="text;html=1;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bt1" value="Power-on / hard reset&#10;config_mode = 1, FPGA bootrom armed at $0000-$3FFF&#10;(tbblue_loader.rom, GPLv3, embedded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bt2" value="FPGA bootrom runs&#10;reads TBBLUE.FW from SD over SPI (divMMC ports $E7/$EB)&#10;copies firmware to RAM at $6000; splash screen&#10;SPACE here = firmware config menu (machine personalities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="420" height="85" as="geometry" />
        </mxCell>
        <mxCell id="bt3" value="TBBLUE firmware (boot.bin)&#10;init_registers() seeds NR$05-$09, $80-$83 from config.ini&#10;streams personality ROMs through the config-mode RAM window&#10;writes NR$03 → machine type set, bootrom mask cleared" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="265" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bt4" value="Soft reset via NR$02 bit 0&#10;reset_type = 3-bit shift history: reads $00 → $02 → $01&#10;(NextZXOS distinguishes first staging pass from later boots)&#10;CPU SoftReset: PC/I/R/IFF/IM cleared, SP/IX/IY survive&#10;paging reset, divMMC entry points re-armed, NR$03 preserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="420" height="105" as="geometry" />
        </mxCell>
        <mxCell id="bt5" value="NextZXOS (enNextZX.rom, 4 × 16K banks)&#10;welcome screen → main menu&#10;Browser / NextBASIC / 128K BASIC / more" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="420" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ebt1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bt1" target="bt2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ebt2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bt2" target="bt3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ebt3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bt3" target="bt4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ebt4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bt4" target="bt5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="title-browser" value="Browser boot accelerators (opt-in via go.env in GoEmulator.js)" style="text;html=1;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="560" y="30" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="db1" value="Direct-core boot&#10;ZX_GO_NO_FPGA_BOOTROM=1 + ZX_GO_NEXT_DIRECT_BOOT=1&#10;skips bootrom + firmware execution; CPU resets straight into&#10;the NextZXOS ROM with the post-firmware NextReg personality&#10;seeded from cmd/zx_go/next_directboot.go&#10;(seed table captured from a live boot — COUPLED to the&#10;SD distro version; drift = boot hang)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="db2" value="Fastboot fast-forward (fastboot.go)&#10;NOT a skip — every instruction still executes; the page runs&#10;many zxFrame() calls per displayed frame and discards audio&#10;until PC reaches the NextZXOS menu wait loop (zxFastBoot()&#10;export; cap 4000 frames). Works with both boot paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="215" width="440" height="105" as="geometry" />
        </mxCell>
        <mxCell id="edb1" value="lands in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="db1" target="bt5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edb2" value="compresses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="db2" target="bt2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sd1" value="SD card (pkg/next/sdcard + pkg/next/divmmc)&#10;SPI command set (CMD0/8/9/17/18/24/25, ACMD41, CSD v1/v2, CRC16)&#10;image source (tbblue.mmc) or FAT32 built in-memory from a host tree&#10;zxPutFile / AddFileToFAT32 stage files with VFAT long names + ~N aliases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="380" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sd2" value="Program delivery after boot&#10;.NEX via nexload menu macro · NextBASIC via nextzxos/autoexec.bas&#10;(zxRunNex / zxRunBas exports; reboot re-reads the card)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="495" width="440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="esd1" value="SPI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="sd1" target="bt2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="esd2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="sd1" target="sd2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="esd3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="sd2" target="bt5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note1" value="Invariant (ROADMAP.md): no hacks — zxnext.vhd + t80n VHDL is the oracle.&#10;The faithful chain stays the core default; browser opt-outs live in the consumer (GoEmulator.js), not in the core." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="700" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
