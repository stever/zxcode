# Games
games/

# Spectrum Next install directory — entirely user-local, never
# version-controlled. Holds the user's own copies of the licensed
# NextZXOS ROMs (enNextZX.rom, enNxtmmc.rom — Amstrad/Sky, not
# redistributable), the SD-card content, and any sd.img. The
# emulator downloads/installs these here at runtime (Machine → Next,
# or File → Install Next ROMs…).
#
# NOTE: the GPLv3 FPGA loader (tbblue_loader.rom) IS shipped with the
# emulator, but as an EMBEDDED asset at pkg/roms/data/tbblue_loader.rom
# (committed, attribution in LICENSES/tbblue_loader-NOTICE.md) — NOT
# from this user-local directory. So everything under roms/next/ is
# correctly ignored.
/roms/next/

# Developer tooling & references — LOCAL-ONLY, not part of the public
# repository. _tools/ holds the development oracle/comparison harnesses,
# build helpers, one-off investigation scripts, and the vendored hardware
# references (FPGA VHDL, the NextZXOS distribution — not redistributable).
# Everything here is kept on the maintainer's disk and reconstructed
# locally as needed; none of it is shipped. (Go already excludes
# underscore-prefixed directories from ./... so this never affects builds.)
/_tools/

# Agent / skills metadata (not project sources)
/.agents/
/.claude/
/skills-lock.json

# Stray screenshots user dropped in repo root (debugging captures)
/dubug.png
/fail.png
