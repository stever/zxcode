:8080 {
    route {
        root * /srv
        # On-the-fly compression for text assets (bundle.js etc.); skips
        # responses that already carry a Content-Encoding.
        encode zstd gzip

        # /dist assets have content-hashed filenames (bundle/css) or a
        # content-hash ?v query (wasm etc.), so they change URL whenever
        # content changes — cache them hard.
        @immutable path /dist/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # Everything else must revalidate so clients always pick up the
        # current asset URLs: index.html, /style.css, /assets,
        # asset-manifest.json — and /next, which despite the manifest is NOT
        # versioned in practice. Its manifest entries are written at
        # image-build time from public/next, but the assets that matter (the
        # card, its zip, the ROMs) are licensed content staged onto the DEPLOY
        # HOST afterwards and bind-mounted in, so they are absent when the
        # manifest is built and assetUrl() falls back to a bare path. Cached
        # hard, that path pinned one card in every browser that had ever booted
        # the Next, and restaging the host reached nobody. ETag keeps the
        # revalidation a 304 for the 2.7 MB zip.
        @revalidate {
            not path /dist/*
        }
        header @revalidate Cache-Control "no-cache"

        try_files {path} {path}/ /index.html
        # The Dockerfile builds .br/.gz sidecars for the ~30MB emulator
        # wasm; serve those instead of the raw binary when the client
        # accepts them.
        file_server {
            precompressed br gzip
        }
    }
}
