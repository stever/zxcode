:8080 {
    route {
        root * /srv
        # On-the-fly compression for text assets (bundle.js etc.); skips
        # responses that already carry a Content-Encoding.
        encode zstd gzip

        # /dist assets have content-hashed filenames (bundle) or a content-hash
        # ?v query (wasm etc.); /next assets are ?v-versioned via the asset
        # manifest. Both change URL whenever content changes — cache them hard.
        @immutable path /dist/* /next/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # Everything else (index.html, /style.css, /assets, asset-manifest.json)
        # must revalidate so clients always pick up the current asset URLs.
        @revalidate {
            not path /dist/* /next/*
        }
        header @revalidate Cache-Control "no-cache"

        try_files {path} {path}/ /index.html
        # The Dockerfile builds .br/.gz sidecars for the ~30MB emulator
        # wasm; serve those instead of the raw binary when the client
        # accepts them.
        file_server {
            precompressed br gzip
        }
    }
}
